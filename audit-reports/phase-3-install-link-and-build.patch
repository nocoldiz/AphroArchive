+
+.video-player-wrap video {
+  width: 100%;
+  display: block;
+  max-height: 85vh
+}
+
+/* When the wrapper itself is the fullscreen element (kept stable so fullscreen
+   survives switching to the next/previous video), drop the library layout caps. */
+.video-player-wrap:fullscreen,
+.video-player-wrap:-webkit-full-screen {
+  max-width: none;
+  width: 100%;
+  height: 100%;
+  border-radius: 0
+}
+
+.video-player-wrap:fullscreen .advanced-player,
+.video-player-wrap:-webkit-full-screen .advanced-player {
+  width: 100%;
+  height: 100%
+}
+
+.video-subtitle-overlay {
+  position: absolute;
+  bottom: 12%;
+  left: 0;
+  right: 0;
+  text-align: center;
+  pointer-events: none;
+  z-index: 10;
+  padding: 0 40px;
+  display: none;
+  transition: bottom 0.3s;
+}
+
+.video-subtitle-overlay span {
+  background: rgba(0, 0, 0, 0.75);
+  color: #fff;
+  padding: 5px 14px;
+  border-radius: 6px;
+  font-size: 1.25rem;
+  font-weight: 500;
+  text-shadow: 0 1px 3px rgba(0, 0, 0, 0.8);
