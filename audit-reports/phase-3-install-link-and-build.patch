+
+.mos-layout-6, .mos-layout-a, .mos-layout-b, .mos-layout-c, .mos-layout-d, .mos-layout-e {
+  grid-template-columns: repeat(12, 1fr);
+  grid-template-rows: repeat(12, 1fr);
+  gap: 4px;
+}
+
+/* Layout A (Original 6-style but flexible) */
+.mos-layout-a .mos-tile:nth-child(1) { grid-column: 1 / 9; grid-row: 1 / 9; }
+.mos-layout-a .mos-tile:nth-child(2) { grid-column: 9 / 13; grid-row: 1 / 5; }
+.mos-layout-a .mos-tile:nth-child(3) { grid-column: 9 / 13; grid-row: 5 / 9; }
+.mos-layout-a .mos-tile:nth-child(4) { grid-column: 1 / 5; grid-row: 9 / 13; }
+.mos-layout-a .mos-tile:nth-child(5) { grid-column: 5 / 9; grid-row: 9 / 13; }
+.mos-layout-a .mos-tile:nth-child(6) { grid-column: 9 / 13; grid-row: 9 / 13; }
+
+/* Layout B (Center Big) */
+.mos-layout-b .mos-tile:nth-child(1) { grid-column: 4 / 10; grid-row: 4 / 10; }
+.mos-layout-b .mos-tile:nth-child(2) { grid-column: 1 / 4; grid-row: 1 / 7; }
+.mos-layout-b .mos-tile:nth-child(3) { grid-column: 10 / 13; grid-row: 1 / 7; }
+.mos-layout-b .mos-tile:nth-child(4) { grid-column: 1 / 7; grid-row: 7 / 13; }
+.mos-layout-b .mos-tile:nth-child(5) { grid-column: 7 / 13; grid-row: 7 / 13; }
+.mos-layout-b .mos-tile:nth-child(6) { grid-column: 4 / 10; grid-row: 1 / 4; }
+
+/* Layout C (Diagonal Split) */
+.mos-layout-c .mos-tile:nth-child(1) { grid-column: 1 / 7; grid-row: 1 / 7; }
+.mos-layout-c .mos-tile:nth-child(2) { grid-column: 7 / 13; grid-row: 7 / 13; }
+.mos-layout-c .mos-tile:nth-child(3) { grid-column: 7 / 13; grid-row: 1 / 4; }
+.mos-layout-c .mos-tile:nth-child(4) { grid-column: 7 / 10; grid-row: 4 / 7; }
+.mos-layout-c .mos-tile:nth-child(5) { grid-column: 10 / 13; grid-row: 4 / 7; }
+.mos-layout-c .mos-tile:nth-child(6) { grid-column: 1 / 7; grid-row: 7 / 13; }
+
+/* Layout D (Four Corners Small, Middle Large) */
+.mos-layout-d .mos-tile:nth-child(1) { grid-column: 3 / 11; grid-row: 1 / 13; }
+.mos-layout-d .mos-tile:nth-child(2) { grid-column: 1 / 3; grid-row: 1 / 4; }
+.mos-layout-d .mos-tile:nth-child(3) { grid-column: 1 / 3; grid-row: 4 / 13; }
+.mos-layout-d .mos-tile:nth-child(4) { grid-column: 11 / 13; grid-row: 1 / 4; }
+.mos-layout-d .mos-tile:nth-child(5) { grid-column: 11 / 13; grid-row: 4 / 10; }
+.mos-layout-d .mos-tile:nth-child(6) { grid-column: 11 / 13; grid-row: 10 / 13; }
+
+/* Layout E (Strips) */
+.mos-layout-e .mos-tile:nth-child(1) { grid-column: 1 / 5; grid-row: 1 / 13; }
+.mos-layout-e .mos-tile:nth-child(2) { grid-column: 5 / 9; grid-row: 1 / 13; }
+.mos-layout-e .mos-tile:nth-child(3) { grid-column: 9 / 13; grid-row: 1 / 7; }
+.mos-layout-e .mos-tile:nth-child(4) { grid-column: 9 / 13; grid-row: 7 / 13; }
+.mos-layout-e .mos-tile:nth-child(5) { grid-column: 1 / 13; grid-row: 1 / 1; display:none; }
+.mos-layout-e .mos-tile:nth-child(6) { grid-column: 1 / 13; grid-row: 1 / 1; display:none; }
