+  display: flex;
+  align-items: center;
+  gap: 8px;
+  padding: 7px 12px;
+  cursor: pointer;
+  font-size: 0.8rem;
+  transition: background 0.1s;
+}
+
+.zap-suggestion-item:hover {
+  background: rgba(255, 255, 255, 0.1);
+}
+
+.zap-suggestion-type {
+  font-size: 0.68rem;
+  font-weight: 700;
+  text-transform: uppercase;
+  width: 40px;
+  flex-shrink: 0;
+  letter-spacing: 0.03em;
+}
+
+.zap-stype-actor  { color: rgba(160, 110, 255, 0.9); }
+.zap-stype-folder { color: rgba(80, 170, 255, 0.9); }
+.zap-stype-tag    { color: rgba(80, 210, 130, 0.9); }
+.zap-stype-text   { color: rgba(255, 255, 255, 0.45); }
+
+.zap-suggestion-val {
+  color: #fff;
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+
+/* ── AND/OR toggle + filter footer ── */
+.zap-filter-footer {
+  display: flex;
+  align-items: center;
+  gap: 5px;
+  margin-top: 5px;
+}
+
+.zap-andor-btn {
+  background: rgba(255, 255, 255, 0.05);
+  border: 1px solid rgba(255, 255, 255, 0.15);
+  border-radius: 10px;
+  color: rgba(255, 255, 255, 0.5);
+  cursor: pointer;
+  font-size: 0.7rem;
+  font-weight: 700;
+  padding: 2px 8px;
+  transition: background 0.15s, color 0.15s, border-color 0.15s;
+}
+
+.zap-andor-btn.active {
+  background: var(--ac, #ff4a4a);
+  border-color: var(--ac, #ff4a4a);
+  color: #fff;
+}
+
+.zap-filter-count {
+  color: rgba(255, 255, 255, 0.45);
+  font-size: 0.72rem;
+  margin-left: auto;
+}
+
+.zap-filter-clear {
+  background: none;
+  border: none;
+  color: rgba(255, 255, 255, 0.4);
+  cursor: pointer;
+  font-size: 0.72rem;
+  padding: 2px 4px;
+  transition: color 0.15s;
+}
+
+.zap-filter-clear:hover { color: #fff; }
+
+/* ── Shared UI kit (ui-*) ──────────────────────────────────────────────────
+   Token-only building blocks for replacing inline styles. Legacy names that
+   components already use but that were never defined (.btn, .btn-sm,
+   .btn-danger, .modal, .modal-content, .modal-body, .modal-input,
+   .modal-btn--secondary/--danger) are aliased here. Modals: prefer the themed
+   .modal-overlay.on + .modal-dialog + .modal-header/-body/-footer + .modal-btn. */
+
+.ui-btn,
+.btn,
+.btn-sm {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 6px;
+  padding: 8px 14px;
+  border-radius: 6px;
+  background: var(--bg3);
+  border: 1px solid var(--brd);
+  color: var(--tx);
+  font-size: 0.85rem;
+  font-weight: 500;
+  line-height: 1.2;
+  white-space: nowrap;
+  cursor: pointer;
+  transition: background var(--tr), border-color var(--tr), color var(--tr), filter var(--tr)
+}
+
+.ui-btn:hover,
+.btn:hover,
+.btn-sm:hover {
+  background: var(--bg4);
+  border-color: var(--tx3)
+}
+
+.ui-btn:disabled {
+  opacity: 0.5;
+  cursor: default;
+  pointer-events: none
+}
+
+.ui-btn--primary,
+.ui-btn--primary:hover {
+  background: var(--ac);
+  border-color: var(--ac);
+  color: #fff
+}
+
+.ui-btn--primary:hover {
+  filter: brightness(1.1)
+}
+
+.ui-btn--danger,
+.btn-danger,
+.modal-btn--danger {
+  background: transparent;
+  border-color: var(--danger);
+  color: var(--danger)
+}
+
+.ui-btn--danger:hover,
+.btn-danger:hover,
+.modal-btn--danger:hover {
+  background: var(--danger);
+  border-color: var(--danger);
+  color: #fff
+}
+
+.ui-btn--ghost {
+  background: transparent;
+  border-color: transparent;
+  color: var(--tx2)
+}
+
+.ui-btn--ghost:hover {
+  background: var(--bg3);
+  border-color: transparent;
+  color: var(--tx)
+}
+
+.ui-btn--sm,
+.btn-sm,
+.modal-btn--sm {
+  padding: 4px 10px;
+  font-size: 0.75rem;
+  border-radius: 5px;
+  gap: 4px
+}
+
+.ui-btn--icon {
+  padding: 6px;
+  line-height: 1
+}
+
+/* Inputs: works on input, select and textarea */
+.ui-input,
+.modal-input {
+  width: 100%;
+  padding: 8px 12px;
+  background: var(--bg3);
+  border: 1px solid var(--brd);
+  border-radius: 6px;
+  color: var(--tx);
+  font-family: inherit;
+  font-size: 0.85rem;
+  outline: none;
+  transition: border-color var(--tr)
+}
+
+.ui-input:focus,
+.modal-input:focus {
+  border-color: var(--ac)
+}
+
+.ui-input::placeholder,
+.modal-input::placeholder {
+  color: var(--tx3)
+}
+
+textarea.ui-input,
+textarea.modal-input {
+  resize: vertical;
+  line-height: 1.5
+}
+
+select.ui-input {
+  cursor: pointer
+}
+
+select.ui-input option {
+  background: var(--bg2);
+  color: var(--tx)
+}
+
+.ui-label {
+  display: block;
+  font-size: 0.78rem;
+  color: var(--tx3);
+  margin-bottom: 4px
+}
+
+/* Legacy overlay/panel pair (.modal.on > .modal-content) — never had styles */
+.modal {
+  position: fixed;
+  inset: 0;
+  z-index: 10000;
+  background: rgba(0, 0, 0, 0.85);
+  display: none;
+  align-items: center;
+  justify-content: center;
+  backdrop-filter: blur(6px)
+}
+
+.modal.on {
+  display: flex
+}
+
+.modal-content {
+  background: var(--bg2);
+  color: var(--tx);
+  border: 1px solid var(--brd);
+  border-radius: var(--rl);
+  padding: 24px;
+  width: 90%;
+  max-width: 480px;
+  box-shadow: var(--sh)
+}
+
+.modal-body p {
+  line-height: 1.5
+}
+
+.modal-body p + p {
+  margin-top: 8px
+}
+
+/* View header row: title left, actions pushed right */
+.ui-toolbar {
+  display: flex;
+  align-items: center;
+  flex-wrap: wrap;
+  gap: 10px;
+  margin-bottom: 20px
+}
+
+.ui-toolbar__actions {
+  display: flex;
+  align-items: center;
+  flex-wrap: wrap;
+  gap: 6px;
+  margin-left: auto
+}
+
+.ui-title {
+  margin: 0;
+  font-size: 1.25rem;
+  font-weight: 700;
+  letter-spacing: -0.3px
+}
+
+/* Non-interactive badge (counts, status); interactive pills use .ui-chip */
+.ui-badge {
+  display: inline-flex;
+  align-items: center;
+  gap: 4px;
+  padding: 2px 8px;
+  border-radius: 999px;
+  background: var(--bg3);
+  color: var(--tx2);
+  font-size: 0.7rem;
+  font-weight: 600;
+  line-height: 1.4;
+  white-space: nowrap
+}
+
+.ui-badge--ac {
+  background: var(--acg);
+  color: var(--ac)
+}
+
+.ui-badge--danger {
+  background: color-mix(in srgb, var(--danger) 15%, transparent);
+  color: var(--danger)
+}
+
+.ui-tab:not(.on):hover {
+  color: var(--tx);
+  border-color: var(--tx3)
+}
+
+.empty-state--sm {
+  padding: 40px 20px
+}
