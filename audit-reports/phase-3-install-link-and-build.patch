+﻿*,
+*::before,
+*::after {
+  box-sizing: border-box;
+  margin: 0;
+  padding: 0
+}
+
+:root {
+  --bg: #0c0c0e;
+  --bg2: #151518;
+  --bg3: #1c1c21;
+  --bg4: #242429;
+  --tx: #e8e6e3;
+  --tx2: #8a8a8e;
+  --tx3: #555558;
+  --ac: #e84040;
+  --acg: rgba(232, 64, 64, 0.18);
+  --acs: #ff6b6b;
+  --star: #fbbf24;
+  --brd: #252529;
+  --topbg: rgba(12, 12, 14, 0.92);
+  --r: 10px;
+  --rl: 14px;
+  --f: 'DM Sans', sans-serif;
+  --m: 'Space Mono', monospace;
+  --sh: 0 8px 32px rgba(0, 0, 0, 0.45);
+  --tr: 0.2s cubic-bezier(0.4, 0, 0.2, 1);
+  --danger: #e5484d;
+  /* Aliases: names components reference that were never defined (resolve per theme) */
+  --accent: var(--ac);
+  --acc: var(--ac);
+  --border: var(--brd);
+  --text: var(--tx);
+  --tx1: var(--tx);
+  --text-muted: var(--tx2);
+  --bg1: var(--bg);
+  --err: var(--danger);
+}
+
+html {
+  font-size: 15px;
+  background: var(--bg);
+  color: var(--tx);
+  font-family: var(--f)
+}
+
+body {
+  min-height: 100vh;
+  overflow-x: hidden
+}
+
+a {
+  color: inherit;
+  text-decoration: none
+}
+
+button {
+  font-family: inherit;
+  cursor: pointer;
+  border: none;
+  background: none;
+  color: inherit
+}
+
+input {
+  font-family: inherit;
+  color: inherit
+}
+
+::-webkit-scrollbar {
+  width: 5px
+}
+
+::-webkit-scrollbar-track {
+  background: transparent
+}
+
+::-webkit-scrollbar-thumb {
+  background: #333;
+  border-radius: 3px
+}
+
+/* ── Topbar ── */
+.topbar {
+  position: fixed;
+  top: 0;
+  left: 0;
+  right: 0;
+  z-index: 100;
+  display: flex;
+  align-items: center;
+  gap: 14px;
+  padding: 10px 20px;
+  background: var(--topbg);
+  backdrop-filter: blur(16px);
+  border-bottom: 1px solid var(--brd)
+}
+
+.logo {
+  font-family: var(--m);
+  font-weight: 700;
+  font-size: 1.2rem;
+  color: var(--ac);
+  cursor: pointer;
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  flex-shrink: 0;
+  letter-spacing: -0.5px;
+  user-select: none
+}
+
+.logo svg {
+  width: 26px;
+  height: 26px
+}
+
+.search-w {
+  flex: 1;
+  max-width: 480px;
+  margin: 0 auto;
+  position: relative;
+  display: flex;
+  align-items: center
+}
+
+.search-w input {
+  width: 100%;
+  padding: 9px 40px 9px 38px;
+  background: var(--bg2);
+  border: 1px solid var(--brd);
+  border-radius: 999px;
+  font-size: 0.9rem;
+  outline: none;
+  transition: border var(--tr), box-shadow var(--tr)
+}
+
+.search-w input:focus {
+  border-color: var(--ac);
+  box-shadow: 0 0 0 3px var(--acg)
+}
+
+.search-w input::placeholder {
+  color: var(--tx3)
+}
+
+.search-w .si {
+  position: absolute;
+  left: 12px;
+  top: 50%;
+  transform: translateY(-50%);
+  color: var(--tx3);
+  pointer-events: none
+}
+
+.search-ghost {
+  position: absolute;
+  left: 0;
+  top: 0;
+  width: 100%;
+  height: 100%;
+  padding: 9px 14px 9px 38px;
+  font-size: 0.9rem;
+  pointer-events: none;
+  white-space: pre;
+  overflow: hidden;
+  border-radius: 999px;
+  display: flex;
+  align-items: center
+}
+
+.search-ghost .ghost-typed {
+  opacity: 0
+}
+
+.search-ghost .ghost-hint {
+  color: var(--tx3);
+  opacity: 0.7
+}
+
+/* Filter / scope picker — anchored inside the search bar at the right edge so
+   it never adds height to the bar (which would knock the search icon off centre). */
+.search-scope {
+  position: absolute;
+  right: 6px;
+  top: 50%;
+  transform: translateY(-50%)
+}
+
+.search-scope-btn {
+  display: flex;
