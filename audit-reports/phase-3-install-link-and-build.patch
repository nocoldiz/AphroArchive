+/* --- 1. Base Transitions (Smoothness) --- */
+.vault-ct img,
+.vault-folder-icon svg,
+.size-badge,
+.ext-badge,
+.play-overlay,
+.card-title,
+.card-meta {
+  transition: filter 0.25s ease, opacity 0.25s ease, transform 0.2s ease;
+}
+
+#vaultPhotoImg {
+  display: block;
+  width: 100%;
+  height: 100%;
+  object-fit: contain;
+}
+
+/* --- 2. Toggle Modes (Controlled by JS data-thumb-mode) --- */
+
+/* HIDE MODE: Blur all and unblur when mouse is in grid */
+.video-grid[data-thumb-mode="hide"] .card-thumb img,
+.video-grid[data-thumb-mode="hide"] .card-thumb video {
+  filter: blur(25px) grayscale(1);
+  opacity: 0.15;
+  transition: filter 0.2s ease, opacity 0.2s ease;
+}
+
+.video-grid[data-thumb-mode="hide"]:hover .card-thumb img,
+.video-grid[data-thumb-mode="hide"]:hover .card-thumb video {
+  filter: blur(0) grayscale(0);
+  opacity: 1;
+}
+
+/* HOVER REVEAL MODE: Blur by default, reveal on card hover */
+.video-grid[data-thumb-mode="hover"] .card-thumb img,
+.video-grid[data-thumb-mode="hover"] .card-thumb video {
+  filter: blur(25px) grayscale(1);
+  opacity: 0.15;
+  transition: filter 0.2s ease, opacity 0.2s ease;
+}
+
+.video-grid[data-thumb-mode="hover"] .video-card:hover .card-thumb img,
+.video-grid[data-thumb-mode="hover"] .video-card:hover .card-thumb video {
+  filter: blur(0) grayscale(0);
+  opacity: 1;
+}
+
+/* SHOW MODE: Clear images */
+.video-grid[data-thumb-mode="show"] .card-thumb img,
+.video-grid[data-thumb-mode="show"] .card-thumb video {
+  filter: none !important;
+  opacity: 1 !important;
+}
+
+/* --- 3. Global Auto-Hide (Privacy Mode Override) --- */
+/* When .vault-auto-hide is active, it forces blur regardless of toggle mode */
+#vaultGrid.vault-auto-hide .vault-ct img,
+#vaultGrid.vault-auto-hide .vault-folder-icon svg,
+#vaultGrid.is-blurred.vault-auto-hide .card-thumb img {
+  filter: blur(35px) grayscale(1) !important;
+  opacity: 0.1 !important;
+}
+
+/* Hide all UI elements in Auto-Hide mode */
+#vaultGrid.vault-auto-hide .size-badge,
+#vaultGrid.vault-auto-hide .ext-badge,
+#vaultGrid.vault-auto-hide .play-overlay,
+#vaultGrid.vault-auto-hide .card-title,
+#vaultGrid.vault-auto-hide .card-meta {
+  opacity: 0 !important;
+  pointer-events: none !important;
+}
+
+/* --- 4. Logic Fixes --- */
+
+/* Ensure text is visible when NOT in auto-hide */
+#vaultGrid:not(.vault-auto-hide) .card-title,
+#vaultGrid:not(.vault-auto-hide) .card-meta {
+  opacity: 1;
+}
+
+/* Hide badges in Hide mode too (Optional, for extra clean look) */
+#vaultGrid[data-thumb-mode="hide"] .size-badge,
+#vaultGrid[data-thumb-mode="hide"] .play-overlay {
+  opacity: 0;
+}
