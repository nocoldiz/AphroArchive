+  align-items: center;
+  gap: 4px;
+  padding: 2px 4px 2px 8px;
+  border-radius: 999px;
+  background: var(--ac);
+  color: #fff;
+  font-size: 0.75rem
+}
+
+.filter-chip button {
+  background: none;
+  border: none;
+  color: #fff;
+  cursor: pointer;
+  font-size: 0.95rem;
+  line-height: 1;
+  padding: 0 3px;
+  opacity: 0.85
+}
+
+.filter-chip button:hover {
+  opacity: 1
+}
+
+.tb-acts {
+  display: flex;
+  gap: 6px;
+  flex-shrink: 0
+}
+
+.tb-acts button {
+  padding: 7px 14px;
+  border-radius: 999px;
+  font-size: 0.82rem;
+  font-weight: 500;
+  border: 1px solid var(--brd);
+  transition: all var(--tr)
+}
+
+.tb-acts button:hover {
+  background: var(--bg3);
+  border-color: var(--tx3)
+}
+
+.tb-acts button.on {
+  background: var(--ac);
+  border-color: var(--ac);
+  color: #fff
+}
+
+#importBtn {
+  padding: 7px 10px
+}
+
+/* Ordered topbar area: contains search bar, nav icons, and plugin icons. */
+.tb-moved {
+  display: flex;
+  gap: 6px;
+  flex: 1;
+  min-width: 0;
+  align-items: center;
+}
+
+.tb-moved button {
+  padding: 7px 10px;
+  border-radius: 999px;
+  border: 1px solid var(--brd);
+  transition: all var(--tr);
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  flex-shrink: 0;
+}
+
+.tb-moved button:hover {
+  background: var(--bg3);
+  border-color: var(--tx3)
+}
+
+.tb-moved button.on {
+  background: var(--ac);
+  border-color: var(--ac);
+  color: #fff
+}
+
+/* Drag-to-reorder insert indicator in the topbar */
+.tb-insert-line {
+  display: inline-block;
+  width: 2px;
+  height: 18px;
+  background: var(--ac);
+  border-radius: 1px;
+  vertical-align: middle;
+  margin: 0 1px;
+  pointer-events: none;
+  flex-shrink: 0;
+}
+
+/* Flex wrapper for the search bar + drag handle in tb-moved */
+.search-slot {
+  display: flex;
+  flex: 1;
+  min-width: 0;
+  align-items: center;
+  gap: 4px;
+}
+
+/* Drag handle that appears on hover to let users reorder the search bar */
+.search-drag-handle {
+  background: none;
+  border: none !important;
+  cursor: grab;
+  color: var(--tx3);
+  padding: 4px 3px;
+  border-radius: 4px;
+  flex-shrink: 0;
+  opacity: 0;
+  transition: opacity 0.15s;
+  display: flex;
+  align-items: center;
+}
+
+.search-drag-handle:active {
+  cursor: grabbing;
+}
+
+.search-slot:hover .search-drag-handle {
+  opacity: 0.6;
+}
+
+#dropOverlay {
+  position: fixed;
+  inset: 0;
+  background: rgba(0, 0, 0, .55);
+  backdrop-filter: blur(4px);
+  z-index: 9999;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  pointer-events: none
+}
+
+.drop-overlay-inner {
+  background: var(--bg2);
+  border: 2px dashed var(--ac);
+  border-radius: var(--rl);
+  padding: 48px 64px;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 12px;
+  color: var(--tx);
+  text-align: center
+}
+
+.drop-overlay-inner svg {
+  color: var(--ac)
+}
+
+.drop-overlay-inner p {
+  font-size: 1.2rem;
+  font-weight: 700;
+  margin: 0
+}
+
+.drop-overlay-inner span {
+  font-size: 0.82rem;
+  color: var(--tx3)
+}
+
+/* ── Layout ── */
+.wrap {
+  display: flex;
+  min-height: calc(100vh - 53px);
+  margin-top: 53px
+}
+
+.side {
+  width: 220px;
+  flex-shrink: 0;
+  padding: 0;
+  border-right: 1px solid var(--brd);
+  height: calc(100vh - 53px);
+  position: sticky;
+  top: 53px;
+  display: flex;
+  flex-direction: column
+}
+
+.side-scroll {
+  flex: 1;
+  overflow-y: auto;
+  padding: 16px 0 8px
+}
+
+.donate-btn {
+  display: inline-block;
+  padding: 8px 18px;
+  border-radius: var(--r);
+  border: 1px solid var(--brd);
+  font-size: 0.82rem;
+  color: var(--tx3);
+  text-align: center;
+  text-decoration: none;
+  transition: all var(--tr)
+}
+
+.donate-btn:hover {
+  color: var(--ac);
+  border-color: var(--ac);
+  background: var(--acg)
+}
+
+.side h3 {
+  font-size: 0.65rem;
+  text-transform: uppercase;
+  letter-spacing: 1.5px;
+  color: var(--tx3);
+  padding: 0 16px;
+  margin: 0 0 6px;
+  font-family: var(--m)
+}
+
+.sidebar-item {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  padding: 8px 16px;
+  font-size: 0.92rem;
+  cursor: pointer;
+  transition: all var(--tr);
+  border-left: 3px solid transparent;
+  color: var(--tx2);
+  position: relative
+}
+
+.sidebar-item::after {
+  content: '';
+  position: absolute;
+  bottom: 0;
+  left: 3px;
+  right: 0;
+  height: 1px;
+  background: var(--ac);
+  transform: scaleX(0);
+  transform-origin: left;
+  transition: transform var(--tr)
+}
+
+.sidebar-item:hover::after {
+  transform: scaleX(1)
+}
+
+.sidebar-item:hover {
+  background: var(--bg2);
+  color: var(--tx)
+}
+
+.sidebar-item.on {
+  border-left-color: var(--ac);
+  color: var(--tx);
+  background: var(--bg2)
+}
+
+.sidebar-item.on::after {
+  transform: scaleX(0)
+}
+
+.sidebar-item.drop-over {
+  border-left-color: var(--ac);
+  background: var(--acg);
+  color: var(--tx)
+}
+
+.sidebar-folder-chevron {
+  cursor: pointer;
+  opacity: 0.6
+}
+
+.sidebar-folder-chevron:hover {
+  opacity: 1
+}
+
+.sidebar-item .count-badge {
+  font-family: var(--m);
+  font-size: 0.7rem;
+  color: var(--tx3);
+  background: var(--bg);
+  padding: 1px 7px;
+  border-radius: 999px
+}
+
+.main-content {
+  flex: 1;
+  padding: 20px 24px;
+  min-width: 0
+}
+
+/* ── Section ── */
+.section-header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  margin-bottom: 16px;
+  flex-wrap: wrap;
+  gap: 8px
+}
+
+.section-header h2 {
+  font-size: 1.25rem;
+  font-weight: 700;
+  letter-spacing: -0.3px
+}
+
+#result-count {
+  font-size: 0.78rem;
+  color: var(--tx3);
+  font-weight: 500;
+  margin-left: 8px;
+  align-self: center
+}
+
+.crumb-sep {
+  color: var(--tx3);
+  font-weight: 400
+}
+
+.crumb--link {
+  cursor: pointer;
+  transition: color var(--tr)
+}
+
+.crumb--link:hover {
+  color: var(--ac);
+  text-decoration: underline
+}
+
+.search-extra-heading {
+  font-size: 1rem;
+  font-weight: 700;
+  letter-spacing: -0.2px;
+  margin: 28px 0 12px;
+  padding-top: 20px;
+  border-top: 1px solid var(--brd)
+}
+
+.section-controls {
+  display: flex;
+  gap: 3px;
+  flex-wrap: wrap;
+  align-items: center
+}
+
+.sg-sep {
+  width: 1px;
+  height: 16px;
+  background: var(--brd);
+  margin: 0 4px;
+  flex-shrink: 0
+}
+
+.sort-btn {
+  padding: 5px 11px;
+  border-radius: 999px;
+  font-size: 0.75rem;
+  color: var(--tx3);
+  transition: all var(--tr);
+  font-weight: 500
+}
+
+.sort-btn:hover {
+  color: var(--tx);
+  background: var(--bg2)
+}
+
+.sort-btn.on {
+  color: var(--ac);
+  background: var(--acg)
+}
+
+/* ── Grid ── */
+.video-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(var(--card-min, 270px), 1fr));
+  gap: 18px;
+  margin-bottom: 36px
+}
+
+/* ── List View ── */
+.video-list-view {
+  display: flex;
+  flex-direction: column;
+  margin-bottom: 36px;
+  border: 1px solid var(--brd);
+  border-radius: var(--rl);
+  overflow: hidden;
+}
+.vl-header,
+.video-list-row {
+  display: grid;
+  grid-template-columns: 72px 1fr 80px 90px 70px 110px 36px;
+  align-items: center;
+  gap: 0 12px;
+  padding: 0 10px;
+  min-height: 52px;
+}
+.vl-header {
+  background: var(--bg3);
+  border-bottom: 1px solid var(--brd);
+  font-size: 0.72rem;
+  font-weight: 600;
+  color: var(--tx3);
+  text-transform: uppercase;
+  letter-spacing: 0.04em;
+  min-height: 32px;
+}
+.video-list-row {
+  background: var(--bg2);
+  border-bottom: 1px solid var(--brd);
+  cursor: pointer;
+  transition: background 0.15s;
+}
+.video-list-row:last-child { border-bottom: none; }
+.video-list-row:hover { background: var(--bg3); }
+.video-list-row.selected { background: color-mix(in srgb, var(--ac) 12%, var(--bg2)); }
+.vl-thumb {
+  width: 64px;
+  height: 40px;
+  object-fit: cover;
+  border-radius: 4px;
+  display: block;
+  background: var(--bg3);
+}
+.vl-title {
+  font-size: 0.85rem;
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+.vl-dur, .vl-size, .vl-rating, .vl-date {
+  font-size: 0.78rem;
+  color: var(--tx3);
+  white-space: nowrap;
+}
+.vl-fav {
+  background: none;
+  border: none;
+  cursor: pointer;
+  color: var(--tx3);
+  font-size: 1rem;
+  padding: 0 4px;
+  transition: color 0.15s;
+}
+.vl-fav:hover { color: var(--ac); }
+
+/* ── Year / Decade Groups ── */
+.year-group { margin-bottom: 32px; }
+.year-group-header {
+  font-size: 1.1rem;
+  font-weight: 700;
+  color: var(--tx);
+  margin: 0 0 12px;
+  padding-bottom: 6px;
+  border-bottom: 2px solid var(--ac);
+  display: flex;
+  align-items: baseline;
+  gap: 8px;
+  opacity: 0;
+  transform: translateY(8px);
+  transition: opacity 0.4s ease, transform 0.35s ease;
+}
+.year-group-header.visible {
+  opacity: 1;
+  transform: translateY(0);
+}
+.year-group-count {
+  font-size: 0.78rem;
+  font-weight: 400;
+  color: var(--tx3);
+}
+
+/* ── Card ── */
+.video-card {
+  display: block;
+  border-radius: var(--rl);
+  overflow: hidden;
+  background: var(--bg2);
+  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
+  cursor: pointer;
+  position: relative
+}
+
+.video-card:hover {
+  transform: translateY(-3px);
+  box-shadow: var(--sh);
+  background: var(--bg3)
+}
+
+.video-card[draggable="true"]:active {
+  opacity: 0.6;
+  transform: scale(0.97)
+}
+
+.card-thumb {
+  position: relative;
+  aspect-ratio: 16/9;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  overflow: hidden
+}
+
+.card-thumb .ext-badge {
+  font-family: var(--m);
+  font-size: 0.7rem;
+  font-weight: 700;
+  text-transform: uppercase;
+  letter-spacing: 1px;
+  opacity: 0.5
+}
+
+.card-thumb .play-overlay {
+  position: absolute;
+  inset: 0;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  background: rgba(0, 0, 0, 0.45);
+  opacity: 0;
+  transition: opacity var(--tr)
+}
+
+.video-card:hover .play-overlay {
+  opacity: 1
+}
+
+.play-overlay svg {
+  width: 44px;
+  height: 44px;
+  color: #fff;
+  filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.5))
+}
+
+.card-thumb .size-badge {
+  position: absolute;
+  bottom: 6px;
+  right: 8px;
+  font-family: var(--m);
+  font-size: 0.65rem;
+  background: rgba(0, 0, 0, 0.7);
+  padding: 2px 7px;
+  border-radius: 5px;
+  color: var(--tx2);
+  backdrop-filter: blur(4px)
+}
+
+.card-thumb .duration-badge {
+  position: absolute;
+  bottom: 6px;
+  left: 8px;
+  font-family: var(--m);
+  font-size: 0.65rem;
+  background: rgba(0, 0, 0, 0.7);
+  padding: 2px 7px;
+  border-radius: 5px;
+  color: var(--tx2);
+  backdrop-filter: blur(4px)
+}
+
+.card-thumb-actions {
+  position: absolute;
+  top: 6px;
+  right: 6px;
+  display: flex;
+  gap: 4px;
+  opacity: 0;
+  transition: opacity var(--tr);
+  z-index: 2
+}
+
+.video-card:hover .card-thumb-actions {
+  opacity: 1
+}
+
+.thumb-actions button {
+  background: rgba(0, 0, 0, 0.5);
+  backdrop-filter: blur(4px);
+  border: 1px solid rgba(255, 255, 255, 0.1);
+  color: white;
+  border-radius: 50%;
+  width: 28px;
+  height: 28px;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  cursor: pointer;
+  transition: background 0.2s, transform 0.2s, color 0.2s;
+}
+.thumb-actions button:hover {
+  background: rgba(0, 0, 0, 0.8);
+  transform: scale(1.1);
+}
+.thumb-actions button.fav-active {
+  color: #ffb700;
+}
+
+.cta-btn {
+  background: rgba(0, 0, 0, 0.6);
+  backdrop-filter: blur(4px);
+  border: none;
+  color: #fff;
+  width: 26px;
+  height: 26px;
+  border-radius: 5px;
+  cursor: pointer;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  flex-shrink: 0;
+  transition: background .15s
+}
+
+.cta-btn:hover {
+  background: rgba(0, 0, 0, 0.85)
+}
+
+.cta-del:hover {
+  background: rgba(200, 40, 40, 0.85)
+}
+
+.card-body {
+  padding: 10px 12px
+}
+
+.card-title {
+  font-size: 0.9rem;
+  font-weight: 500;
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  margin-bottom: 3px
+}
+
+.card-meta {
+  display: flex;
+  align-items: center;
+  justify-content: space-between
+}
+
+.card-category {
+  font-size: 0.75rem;
+  color: var(--tx3);
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  max-width: 65%
+}
+
+.card-actions {
+  display: flex;
+  gap: 2px
+}
+
+.card-actions button {
+  padding: 4px;
+  border-radius: 5px;
+  transition: all var(--tr);
+  color: var(--tx3);
+  display: flex;
+  align-items: center;
+  justify-content: center
+}
+
+.card-actions button:hover {
+  background: var(--bg);
+  color: var(--tx)
+}
+
+.card-actions button.st {
+  color: var(--star)
+}
+
+.card-actions .vault-fav-btn.on {
+  color: #e84040
+}
+
+.card-actions button.pl-off {
+  opacity: 0.3
+}
+
+/* ── Player ── */
+.player-view {
+  display: none
+}
+
+.player-view.on {
+  display: block
+}
+
+.chapters-view {
+  display: block
+}
+
+.browse-view.off {
+  display: none
+}
+
+.back-btn {
+  display: inline-flex;
+  align-items: center;
+  gap: 5px;
+  padding: 7px 14px;
+  border-radius: 999px;
+  font-size: 0.83rem;
+  color: var(--tx2);
+  border: 1px solid var(--brd);
+  transition: all var(--tr);
+  margin-bottom: 14px
+}
+
+.back-btn:hover {
+  background: var(--bg2);
+  color: var(--tx)
+}
+
+.video-player-wrap {
+  width: 100%;
+  max-width: 1200px;
+  margin: 0 auto;
+  border-radius: var(--rl);
+  overflow: hidden;
+  background: #000;
+  box-shadow: 0 12px 48px rgba(0, 0, 0, 0.6);
