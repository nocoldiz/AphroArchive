+  white-space: pre-wrap;
+  line-height: 1.4;
+  backdrop-filter: blur(4px);
+  border: 1px solid rgba(255, 255, 255, 0.1);
+}
+
+/* Move subtitles up when controls are likely visible (though native controls are hard to detect, 
+   we can at least give some breathing room) */
+.video-player-wrap:hover .video-subtitle-overlay {
