-/* --- 1. Base Transitions (Smoothness) --- */
-.vault-ct img,
-.vault-folder-icon svg,
-.size-badge,
-.ext-badge,
-.play-overlay,
-.card-title,
-.card-meta {
-  transition: filter 0.25s ease, opacity 0.25s ease, transform 0.2s ease;
-}
-
-#vaultPhotoImg {
