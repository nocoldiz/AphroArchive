{
  "env": {
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "1"
  },
  "permissions": {
    "allow": [
      "Bash(node:*)",
      "Bash(echo \"EXIT: $?\")",
      "Bash(grep -n \"settings-view\\\\|settings-grid\\\\|donate-btn\\\\|buymeacoffee\\\\|</div>$\\\\|</aside>\" C:/AphroArchive/public/index.html)",
      "Bash(grep -E \"\\\\.js$|\\\\.html$\")",
      "Bash(find:*)",
      "Bash(awk '{print NR\": \"$0}')",
      "Bash(git -C C:/github/AphroArchive ls-files --error-unmatch db/categories.json)",
      "Bash(git -C C:/github/AphroArchive status --short db/presets/actors.json db/presets/categories.json)",
      "Bash(git *)",
      "Bash(Get-ChildItem -Path \"c:\\\\github\\\\AphroArchive\" -Recurse -Depth 2)",
      "Bash(Select-Object FullName)",
      "PowerShell(Get-ChildItem \"c:\\\\github\\\\AphroArchive\\\\db\\\\\" -Recurse | Where-Object {$_.Extension -eq '.json'} | Select-Object FullName)",
      "Bash(npx tsc *)",
      "Bash(Get-ChildItem -Path \"c:\\\\github\\\\AphroArchive\" -Recurse -Directory)",
      "Bash(Select-Object -ExpandProperty FullName)"
    ]
  }
}
